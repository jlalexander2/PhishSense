# Copy to .env locally. Never commit actual credentials.
# Copy the direct/session-pooler URI from Supabase Connect; URL-encode password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PHISHSENSE_SECRET_KEY=
# Trust source: system (libpq 16+) or an absolute trusted CA bundle path.
# Supabase private CA endpoints require the Supabase CA file; system may fail.
PGSSLROOTCERT=system
# Separate disposable Supabase development project for integration tests:
TEST_DATABASE_URL=
